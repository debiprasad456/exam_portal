MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/exam_portal?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
PORT=5000
CLIENT_URL=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME="Diverse Solutions Exam Portal"
SMTP_FROM_EMAIL=your-email@gmail.com

# HTTP Email APIs (Required for Render Free tier because Render blocks SMTP ports 25, 465, 587)
# Option A (Recommended): Brevo (Free 300 emails/day to ANY recipient, no domain needed)
# Sign up at https://brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option B: Resend (Free 3,000 emails/month)
# Sign up at https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="onboarding@resend.dev"

